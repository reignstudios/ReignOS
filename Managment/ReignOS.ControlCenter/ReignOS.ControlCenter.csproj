<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\kde.png" />
    <None Remove="Assets\ReignOS_Icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\kde.png" />
    <AvaloniaResource Include="Assets\ReignOS_Icon.ico" />
    <AvaloniaResource Include="Assets\steam_black.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReignOS.Core\ReignOS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ReignOS.Private">
      <HintPath>..\ReignOS.Private.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
